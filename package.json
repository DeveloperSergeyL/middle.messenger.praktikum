{
  "name": "messenger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite build && vite preview --port 3000",
    "prebuild": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview --port 3000",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "lint": "tsc --noEmit && eslint . && stylelint \"**/*.scss\"",
    "lint:scss": "stylelint \"**/*.scss\"",
    "lint:css:fix": "stylelint --fix \"**/*.scss\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "sass": "^1.105.0",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "handlebars": "^4.7.9"
  },
  "engines": {
    "node": ">=12.0.0"
  }
}
