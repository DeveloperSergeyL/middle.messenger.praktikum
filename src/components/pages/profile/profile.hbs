<div class="profile-container">
    <aside class="profile-sidebar">
        <button type="button" class="profile-sidebar__back-btn" id="profile-back-btn">
            <span class="profile-sidebar__back-icon">➔</span>
        </button>
    </aside>

    <main class="profile-content">
        <div class="profile-content__wrapper">

            <div class="profile-header">
                <div class="profile-avatar-wrapper {{#if (isEqual profileMode "
                    edit-data")}}profile-avatar-wrapper--editable{{/if}}">
                    {{> avatar url=user.avatarUrl class="profile-header__avatar"}}
                    {{#if (isEqual profileMode "edit-data")}}
                    <div class="profile-avatar-overlay">Поменять<br>аватар</div>
                    {{/if}}
                </div>
                {{#if (isEqual profileMode "view")}}
                <h1 class="profile-header__name">{{user.first_name}}</h1>
                {{/if}}
            </div>

            {{#if (isEqual profileMode "view")}}
            <div class="profile-data">
                <div class="profile-data__row"><span class="profile-data__label">Почта</span><span
                        class="profile-data__value">{{user.email}}</span></div>
                <div class="profile-data__row"><span class="profile-data__label">Логин</span><span
                        class="profile-data__value">{{user.login}}</span></div>
                <div class="profile-data__row"><span class="profile-data__label">Имя</span><span
                        class="profile-data__value">{{user.first_name}}</span></div>
                <div class="profile-data__row"><span class="profile-data__label">Фамилия</span><span
                        class="profile-data__value">{{user.second_name}}</span></div>
                <div class="profile-data__row"><span class="profile-data__label">Имя в чате</span><span
                        class="profile-data__value">{{user.display_name}}</span></div>
                <div class="profile-data__row"><span class="profile-data__label">Телефон</span><span
                        class="profile-data__value">{{user.phone}}</span></div>
            </div>

            <div class="profile-actions">
                <div class="profile-actions__row">{{> link href="#" id="edit-data-btn" text="Изменить данные"
                    class="profile-actions__link"}}</div>
                <div class="profile-actions__row">{{> link href="#" id="edit-pass-btn" text="Изменить пароль"
                    class="profile-actions__link"}}</div>
                <div class="profile-actions__row">{{> link href="#" id="profile-logout-btn" text="Выйти"
                    class="profile-actions__link profile-actions__link--danger"}}</div>
            </div>
            {{/if}}

            {{#if (isEqual profileMode "edit-data")}}
            <form class="profile-form" id="profile-data-form" novalidate>
                <div class="profile-form__fields">
                    {{> input class="form-field--profile" id="p-email" name="email" type="email" label="Почта"
                    value=user.email required=true}}
                    {{> input class="form-field--profile" id="p-login" name="login" type="text" label="Логин"
                    value=user.login required=true}}
                    {{> input class="form-field--profile" id="p-first_name" name="first_name" type="text" label="Имя"
                    value=user.first_name required=true}}
                    {{> input class="form-field--profile" id="p-second_name" name="second_name" type="text"
                    label="Фамилия" value=user.second_name required=true}}
                    {{> input class="form-field--profile" id="p-display_name" name="display_name" type="text" label="Имя
                    в чате" value=user.display_name}}
                    {{> input class="form-field--profile" id="p-phone" name="phone" type="tel" label="Телефон"
                    value=user.phone required=true}}
                </div>
                {{> button type="submit" text="Сохранить" class="profile-form__submit-btn"}}
            </form>
            {{/if}}

            {{#if (isEqual profileMode "edit-password")}}
            <form class="profile-form" id="profile-pass-form" novalidate>
                <div class="profile-form__fields">
                    {{> input class="form-field--profile" id="oldPassword" name="oldPassword" type="password"
                    label="Старый пароль" placeholder="•••••••••" required=true}}
                    {{> input class="form-field--profile" id="newPassword" name="newPassword" type="password"
                    label="Новый пароль" placeholder="••••••••••••" required=true}}
                    {{> input class="form-field--profile" id="newPasswordConfirm" name="newPasswordConfirm"
                    type="password" label="Повторите новый пароль" placeholder="••••••••••••" required=true}}
                </div>
                {{> button type="submit" text="Сохранить" class="profile-form__submit-btn"}}
            </form>
            {{/if}}
            {{#if isAvatarModalOpen}}
            {{> avatarModal
            avatarModalState=avatarModalState
            avatarFileName=avatarFileName
            avatarModalError=avatarModalError
            }}
            {{/if}}

        </div>
    </main>
</div>
