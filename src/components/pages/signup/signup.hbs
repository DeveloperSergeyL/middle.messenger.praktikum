<div class="auth-container">
    <main class="auth-card auth-card--signup">
        <h1 class="auth-card__title">Регистрация</h1>

        <form class="auth-card__form" id="signup-form" novalidate>
            {{> input id="email" name="email" type="email" label="Почта" placeholder="pochta@yandex.ru"
            value=values.email error=errors.email required=true}}

            {{> input id="login" name="login" type="text" label="Логин" placeholder="ivanivanov" value=values.login
            error=errors.login required=true}}

            {{> input id="first_name" name="first_name" type="text" label="Имя" placeholder="Иван"
            value=values.first_name error=errors.first_name required=true}}

            {{> input id="second_name" name="second_name" type="text" label="Фамилия" placeholder="Иванов"
            value=values.second_name error=errors.second_name required=true}}

            {{> input id="phone" name="phone" type="tel" label="Телефон" placeholder="+7 (***) *** ** **"
            value=values.phone error=errors.phone required=true}}

            {{> input id="password" name="password" type="password" label="Пароль" placeholder="••••••••••••"
            value=values.password error=errors.password required=true}}

            {{> input id="password_confirm" name="password_confirm" type="password" label="Пароль (ещё раз)"
            placeholder="••••••••••••" value=values.password_confirm error=errors.password_confirm required=true}}

            {{> button type="submit" text="Зарегистрироваться" class="auth-card__submit-btn"}}
        </form>

        {{> link href="/login" id="to-login-btn" text="Войти" class="auth-card__link"}}
    </main>
</div>
